CREATE TABLE Song (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artistName TEXT NOT NULL,
    albumName TEXT,
    durationMs INTEGER NOT NULL DEFAULT 0,
    thumbnailUrl TEXT,
    audioUrl TEXT,
    isLiked INTEGER NOT NULL DEFAULT 0,
    isDownloaded INTEGER NOT NULL DEFAULT 0,
    downloadPath TEXT,
    addedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE Album (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artistName TEXT NOT NULL,
    thumbnailUrl TEXT,
    year INTEGER
);

CREATE TABLE Artist (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    thumbnailUrl TEXT
);

CREATE TABLE Playlist (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    songCount INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE PlaylistSong (
    playlistId TEXT NOT NULL,
    songId TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (playlistId, songId)
);

CREATE TABLE Lyrics (
    songId TEXT NOT NULL PRIMARY KEY,
    syncedLyrics TEXT,
    plainLyrics TEXT,
    provider TEXT
);

CREATE TABLE SearchHistory (
    query TEXT NOT NULL PRIMARY KEY,
    timestamp INTEGER NOT NULL
);

CREATE TABLE PlayStat (
    songId TEXT NOT NULL PRIMARY KEY,
    playCount INTEGER NOT NULL DEFAULT 0,
    lastPlayed INTEGER NOT NULL
);

-- Queries for Song
getAllSongs:
SELECT * FROM Song ORDER BY addedAt DESC;

getLikedSongs:
SELECT * FROM Song WHERE isLiked = 1 ORDER BY addedAt DESC;

getDownloadedSongs:
SELECT * FROM Song WHERE isDownloaded = 1 ORDER BY addedAt DESC;

getSongById:
SELECT * FROM Song WHERE id = ?;

insertSong:
INSERT OR REPLACE INTO Song (id, title, artistName, albumName, durationMs, thumbnailUrl, audioUrl, isLiked, isDownloaded, downloadPath, addedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setLiked:
UPDATE Song SET isLiked = ? WHERE id = ?;

setDownloaded:
UPDATE Song SET isDownloaded = ?, downloadPath = ? WHERE id = ?;

deleteSong:
DELETE FROM Song WHERE id = ?;

-- Queries for Playlists
getAllPlaylists:
SELECT * FROM Playlist ORDER BY createdAt DESC;

insertPlaylist:
INSERT OR REPLACE INTO Playlist (id, name, createdAt, songCount) VALUES (?, ?, ?, ?);

deletePlaylist:
DELETE FROM Playlist WHERE id = ?;

-- Queries for Search History
getRecentSearches:
SELECT * FROM SearchHistory ORDER BY timestamp DESC LIMIT 10;

insertSearch:
INSERT OR REPLACE INTO SearchHistory (query, timestamp) VALUES (?, ?);

deleteSearch:
DELETE FROM SearchHistory WHERE query = ?;

-- Queries for Play Stats
getPlayStat:
SELECT * FROM PlayStat WHERE songId = ?;

incrementPlayCount:
INSERT INTO PlayStat (songId, playCount, lastPlayed) VALUES (?, 1, ?)
ON CONFLICT(songId) DO UPDATE SET playCount = playCount + 1, lastPlayed = excluded.lastPlayed;
